  JUnit tests of the M3 render backend (org.eclipse.swt.internal.render.m3, source folder
  bundles/org.eclipse.swt/Eclipse SWT Maya/win32), moved here from org.eclipse.swt.tests.
  Plain Maven module, like bundles/org.eclipse.swt.maya: the render tree needs the Skija 0.116.3 binding, which is not
  an OSGi bundle of the target platform, and no bundle of the reactor compiles the render tree. This module compiles the
  render tree as test code against the reactor's win32 x86_64 fragment and Skija, then the tests next to it, in every
  build (also with -DskipTests). Nothing of it is shipped. The tests run on Windows x86_64 only (win32 natives), when
  -DskipNativeTests=false, as the other native SWT tests.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.platform</groupId>
  <artifactId>org.eclipse.swt.tests.maya</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>SWT Maya backend tests</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <mayatest.renderSources>${project.basedir}/../../bundles/org.eclipse.swt/Eclipse SWT Maya/win32</mayatest.renderSources>
    <!-- maya's Java side (org.eclipse.swt.internal.maya); its native library comes from the fragment's native folder -->
    <mayatest.javaSources>${project.basedir}/../../bundles/org.eclipse.swt/Eclipse SWT Maya/common</mayatest.javaSources>
    <mayatest.swt.version>3.138.0-SNAPSHOT</mayatest.swt.version>
    <mayatest.jupiter.version>5.14.4</mayatest.jupiter.version>
    <mayatest.platform.version>1.14.4</mayatest.platform.version>
    <skipNativeTests>true</skipNativeTests>
    <!-- the natives are win32 x86_64: other platforms compile the module and skip its tests -->
    <skipTests>true</skipTests>
  </properties>
  <profiles>
    <profile>
      <id>mayatest-win32-x86_64</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <properties><skipTests>${skipNativeTests}</skipTests></properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId><version>${mayatest.swt.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><version>${mayatest.jupiter.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-engine</artifactId><version>${mayatest.jupiter.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite-api</artifactId><version>${mayatest.platform.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite-engine</artifactId><version>${mayatest.platform.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testSourceDirectory>JUnit Tests</testSourceDirectory>
    <!-- maya.dll, the native library of the Maya backend, as the fragment ships it -->
    <testResources><testResource><directory>${project.basedir}/../../bundles/org.eclipse.swt.maya/native</directory></testResource></testResources>
    <plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.2</version>
        <executions><execution><id>add-maya-render-tree</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
          <configuration><sources><source>${mayatest.renderSources}</source><source>${mayatest.javaSources}</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
        <configuration><release>21</release><proc>none</proc></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.1</version>
        <configuration>
          <!-- the suite fixes the order: drawText_NoCache sets RasterTextDrawing.NO_TEXT_CACHE and never clears it -->
          <includes><include>**/AllMayaGcTests.java</include></includes>
          <argLine>-Xcheck:jni</argLine>
          <systemPropertyVariables><user.home>${project.build.directory}</user.home></systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
    </plugins>
  </build>
</project>

+	 */
+	private int deletedTop (int top, int caret, int count, int at, int removed) {
+		int full = Math.max (1, page);
+		for (int k = 0; k < removed; k++) {
+			count--;
+			if (at == caret && caret > 0) caret--;
+			if (caret >= count) caret = Math.max (0, count - 1);
+			if (top >= count) top = Math.max (0, count - full);

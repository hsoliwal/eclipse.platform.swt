  The LLM side of the M3 look and feel generator (docs/m3/look-and-feel/GENERATOR.md): model clients (Ollama,
  Anthropic), the command line, the Swing applier and the example. Outside the SWT bundle, which has no dependencies.
  Build: mvn -Dswt.jar=<the M3 SWT jar> package   (the jar provides org.eclipse.swt.internal.laf)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.eclipse.swt.m3</groupId>
	<artifactId>m3-themegen</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>M3 look and feel generator</name>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<swt.jar>${project.basedir}/swt.jar</swt.jar>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.swt.m3</groupId>
			<artifactId>swt-win32-m3</artifactId>
			<version>local</version>
			<scope>system</scope>
			<systemPath>${swt.jar}</systemPath>
		</dependency>
		<dependency>
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java</artifactId>
			<version>2.70.0</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.18.2</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
		</plugins>
	</build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0; donor metadata and packaged Java retain their own licences. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.swt.maya</artifactId><version>3.137.0-SNAPSHOT</version>
  <name>Optional SWT Maya backend</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><maven.compiler.release>21</maven.compiler.release>
    <maya.sourceDirectory>${project.basedir}/../org.eclipse.swt/Eclipse SWT GPU/win32</maya.sourceDirectory>
    <!-- the Skija Java classes SWT needs, absorbed under their upstream packages (Eclipse SWT Maya/README.md) -->
    <maya.javaDirectory>${project.basedir}/../org.eclipse.swt/Eclipse SWT Maya/common</maya.javaDirectory>
    <maya.buildDirectory>${project.basedir}/target</maya.buildDirectory>
    <maya.finalName>${project.artifactId}-${project.version}</maya.finalName>
    <maya.manifest>${project.basedir}/META-INF/MANIFEST.MF</maya.manifest>
    <maya.swtRoot>${project.basedir}/../..</maya.swtRoot>
  </properties>
  <profiles>
    <profile><id>maya-reactor-dependencies</id>
      <activation><property><name>!maya.provisioned</name></property></activation>
      <dependencies>
        <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId><version>3.138.0-SNAPSHOT</version><scope>provided</scope></dependency>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>provided</scope></dependency>
      </dependencies>
    </profile>
    <profile><id>maya-provisioned-proof</id>
      <activation><property><name>maya.provisioned</name></property></activation>
      <dependencies>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>system</scope><systemPath>${maya.annotations.jar}</systemPath></dependency>
      </dependencies>
      <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration><compilerArgs combine.children="append"><arg>-classpath</arg><arg>${maya.swt.classpath}${path.separator}${project.build.outputDirectory}${path.separator}${maya.annotations.jar}</arg></compilerArgs></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
  <build>
    <directory>${maya.buildDirectory}</directory><finalName>${maya.finalName}</finalName><sourceDirectory>${maya.sourceDirectory}</sourceDirectory>
    <!-- maya.dll, its version and the ICU data it loads, built by Eclipse SWT Maya/native/build_maya.py -->
    <resources><resource><directory>${project.basedir}/native</directory></resource>
      <resource><directory>${maya.swtRoot}</directory><targetPath>META-INF</targetPath>
      <includes><include>LICENSE</include><include>NOTICE</include><include>docs/licenses/swt-gpu-retained-planes-NOTICE.txt</include><include>docs/licenses/swt-gpu-skija-*.txt</include></includes>
    </resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
        <configuration><release>21</release><proc>none</proc><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
          <includes><include>org/eclipse/swt/internal/gpu/OpStreamReplay.java</include><include>org/eclipse/swt/internal/gpu/GlPlaneBackend.java</include><include>org/eclipse/swt/internal/gpu/GpuTarget.java</include></includes>
        </configuration>
        <executions>
          <!-- maya's Java classes first, without the GPU sources' lint gate (third-party code); the GPU sources then
               compile against them in default-compile -->
          <execution><id>compile-maya</id><phase>process-sources</phase><goals><goal>compile</goal></goals>
            <configuration>
              <compileSourceRoots combine.self="override"><compileSourceRoot>${maya.javaDirectory}</compileSourceRoot></compileSourceRoots>
              <includes combine.self="override"><include>org/eclipse/swt/internal/maya/**/*.java</include></includes>
              <compilerArgs combine.self="override"><arg>-nowarn</arg></compilerArgs>
              <showWarnings>false</showWarnings>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifestFile>${maya.manifest}</manifestFile></archive>
          <includes><include>org/eclipse/swt/internal/gpu/**</include><include>org/eclipse/swt/internal/maya/**</include><include>META-INF/**</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

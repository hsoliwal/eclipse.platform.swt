<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0; donor metadata and packaged Java retain their own licences. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.swt.skia</artifactId><version>3.137.0-SNAPSHOT</version>
  <name>Optional SWT Skia backend</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><maven.compiler.release>21</maven.compiler.release>
    <skia.sourceDirectory>${project.basedir}/../org.eclipse.swt/Eclipse SWT GPU/win32</skia.sourceDirectory>
    <!-- the Skija Java classes SWT needs, absorbed under their upstream packages (Eclipse SWT Skija/README.md) -->
    <skia.skijaDirectory>${project.basedir}/../org.eclipse.swt/Eclipse SWT Skija/common</skia.skijaDirectory>
    <skia.buildDirectory>${project.basedir}/target</skia.buildDirectory>
    <skia.finalName>${project.artifactId}-${project.version}</skia.finalName>
    <skia.manifest>${project.basedir}/META-INF/MANIFEST.MF</skia.manifest>
    <skia.swtRoot>${project.basedir}/../..</skia.swtRoot>
  </properties>
  <profiles>
    <profile><id>skia-reactor-dependencies</id>
      <activation><property><name>!skia.provisioned</name></property></activation>
      <dependencies>
        <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId><version>3.138.0-SNAPSHOT</version><scope>provided</scope></dependency>
        <dependency><groupId>io.github.humbleui</groupId><artifactId>skija-windows-x64</artifactId><version>0.116.3</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>provided</scope></dependency>
      </dependencies>
    </profile>
    <profile><id>skia-provisioned-proof</id>
      <activation><property><name>skia.provisioned</name></property></activation>
      <dependencies>
        <dependency><groupId>io.github.humbleui</groupId><artifactId>skija-windows-x64</artifactId><version>0.116.3</version><scope>system</scope><systemPath>${skia.windows.jar}</systemPath></dependency>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>system</scope><systemPath>${skia.annotations.jar}</systemPath></dependency>
      </dependencies>
      <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration><compilerArgs combine.children="append"><arg>-classpath</arg><arg>${skia.swt.classpath}${path.separator}${project.build.outputDirectory}${path.separator}${skia.annotations.jar}</arg></compilerArgs></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
  <build>
    <directory>${skia.buildDirectory}</directory><finalName>${skia.finalName}</finalName><sourceDirectory>${skia.sourceDirectory}</sourceDirectory>
    <resources><resource><directory>${skia.swtRoot}</directory><targetPath>META-INF</targetPath>
      <includes><include>LICENSE</include><include>NOTICE</include><include>docs/licenses/swt-gpu-retained-planes-NOTICE.txt</include><include>docs/licenses/swt-gpu-skija-*.txt</include></includes>
    </resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
        <configuration><release>21</release><proc>none</proc><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
          <includes><include>org/eclipse/swt/internal/gpu/OpStreamReplay.java</include><include>org/eclipse/swt/internal/gpu/GlPlaneBackend.java</include><include>org/eclipse/swt/internal/gpu/GpuTarget.java</include></includes>
        </configuration>
        <executions>
          <!-- the absorbed Skija classes first, without the GPU sources' lint gate (third-party code); the GPU sources then
               compile against them in default-compile -->
          <execution><id>compile-skija</id><phase>process-sources</phase><goals><goal>compile</goal></goals>
            <configuration>
              <compileSourceRoots combine.self="override"><compileSourceRoot>${skia.skijaDirectory}</compileSourceRoot></compileSourceRoots>
              <includes combine.self="override"><include>io/github/humbleui/**/*.java</include></includes>
              <compilerArgs combine.self="override"><arg>-nowarn</arg></compilerArgs>
              <showWarnings>false</showWarnings>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
        <executions><execution><id>embed-pinned-skija-runtime</id><phase>prepare-package</phase><goals><goal>copy-dependencies</goal></goals>
          <configuration><includeArtifactIds>skija-windows-x64</includeArtifactIds><excludeTransitive>true</excludeTransitive><outputDirectory>${project.build.outputDirectory}/lib</outputDirectory></configuration>
        </execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifestFile>${skia.manifest}</manifestFile></archive>
          <includes><include>org/eclipse/swt/internal/gpu/**</include><include>io/github/humbleui/**</include><include>lib/*.jar</include><include>META-INF/**</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
